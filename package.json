{
  "name": "schafe-vorm-fenster-www",
  "version": "1.0.0",
  "description": "The official Schafe vorm Fenster website.",
  "private": true,
  "license": "ISC",
  "packageManager": "pnpm@10.26.0",
  "scripts": {
    "dev": "PORT=3100 next dev",
    "build": "next build && node scripts/generate-csp-hashes.mjs",
    "start": "PORT=3100 next start",
    "stop": "lsof -ti:3100 | xargs kill -9 || true",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run '**/*.integration.test.ts'",
    "test:watch": "vitest watch",
    "test:ci": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ci": "playwright test",
    "check": "pnpm check:frontmatter && pnpm check:content && pnpm check:specs && pnpm check:stack && pnpm check:brand && pnpm check:api-routes && pnpm check:static-tests && pnpm typecheck && pnpm lint && pnpm test",
    "check:frontmatter": "tsx scripts/check-frontmatter.ts",
    "check:content": "tsx scripts/check-content.ts",
    "check:specs": "tsx scripts/check-specs.ts",
    "check:stack": "tsx scripts/check-stack.ts",
    "check:brand": "tsx scripts/check-brand.ts",
    "check:api-routes": "tsx scripts/check-api-routes.ts",
    "check:static-tests": "vitest run --config scripts/vitest.config.mts",
    "env:pull": "vercel env pull .env.local --environment development",
    "import:legal-content": "tsx legacy-content/scripts/import-content.ts",
    "import:legal-content:dry-run": "tsx legacy-content/scripts/import-content.ts --dry-run",
    "fetch:openapi": "tsx scripts/fetch-openapi.mjs",
    "preflight": "node scripts/preflight.mjs",
    "placeholders": "node scripts/make-placeholders.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-mono": "5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@schafe-vorm-fenster/brand-design": "0.1.3",
    "js-yaml": "4.3.2",
    "lucide-react": "1.45.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@schafe-vorm-fenster/audiences": "^0.3.3",
    "@schafe-vorm-fenster/brand-identity": "^0.1.4",
    "@schafe-vorm-fenster/goals": "^0.3.0",
    "@schafe-vorm-fenster/media-echo": "^0.3.3",
    "@schafe-vorm-fenster/messaging": "^0.1.0",
    "@schafe-vorm-fenster/offerings": "^0.3.3",
    "@schafe-vorm-fenster/partners": "^0.2.4",
    "@schafe-vorm-fenster/people": "^0.3.6",
    "@schafe-vorm-fenster/posts": "^0.4.0",
    "@schafe-vorm-fenster/proof": "^0.3.5",
    "@types/js-yaml": "4.0.9",
    "@types/node": "25.9.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "4.1.11",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "googleapis": "171.4.0",
    "husky": "9.1.7",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vercel": "53.4.0",
    "vitest": "4.1.11"
  }
}
