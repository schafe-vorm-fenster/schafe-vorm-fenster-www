{
  "name": "schafe-vorm-fenster-www",
  "version": "1.0.0",
  "description": "The official Schafe vorm Fenster website.",
  "private": true,
  "license": "ISC",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "next dev --port ${PORT:-3100}",
    "build": "next build",
    "start": "PORT=3100 next start",
    "stop": "lsof -ti:3100 | xargs kill -9 || true",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run '**/*.integration.test.ts'",
    "test:watch": "vitest watch",
    "test:ci": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ci": "playwright test",
    "e2e:technical": "playwright test e2e/smoke.spec.ts e2e/csp-hydration.spec.ts e2e/routes.spec.ts e2e/external-links.spec.ts e2e/layout-stability.spec.ts e2e/a11y.spec.ts e2e/privacy.spec.ts",
    "e2e:smoke": "playwright test e2e/smoke.spec.ts e2e/csp-hydration.spec.ts e2e/routes.spec.ts",
    "check": "pnpm check:frontmatter && pnpm check:content:production && pnpm check:specs && pnpm check:locators && pnpm check:coverage && pnpm check:stack && pnpm check:brand && pnpm check:reviews && pnpm check:contrast && pnpm check:seo-budget && pnpm check:terms && pnpm check:api-routes && pnpm check:csp && pnpm check:search-wording && pnpm check:module-class-locators && pnpm check:static-tests && pnpm typecheck && pnpm lint && pnpm test",
    "check:frontmatter": "tsx scripts/check-frontmatter.ts",
    "check:content": "tsx scripts/check-content.ts",
    "check:content:production": "tsx scripts/check-content.ts --target production",
    "check:specs": "tsx scripts/check-specs.ts",
    "check:locators": "tsx scripts/check-locators.ts",
    "check:coverage": "tsx scripts/check-coverage.ts",
    "check:stack": "tsx scripts/check-stack.ts",
    "check:reviews": "tsx scripts/check-reviews.ts",
    "check:brand": "tsx scripts/check-brand.ts",
    "check:contrast": "tsx scripts/check-contrast.ts",
    "check:seo-budget": "tsx scripts/check-seo-budget.ts",
    "check:terms": "tsx scripts/check-terms.ts",
    "check:image-routes": "tsx scripts/check-image-routes.ts",
    "check:api-routes": "tsx scripts/check-api-routes.ts",
    "check:csp": "tsx scripts/check-csp.ts",
    "check:search-wording": "tsx scripts/check-search-wording.ts",
    "check:module-class-locators": "tsx scripts/check-module-class-locators.ts",
    "check:static-tests": "vitest run --config scripts/vitest.config.mts",
    "env:pull": "vercel env pull .env.local --environment development",
    "import:legal-content": "tsx legacy-content/scripts/import-content.ts",
    "import:legal-content:dry-run": "tsx legacy-content/scripts/import-content.ts --dry-run",
    "fetch:openapi": "tsx scripts/fetch-openapi.mjs",
    "build:place-index": "tsx scripts/build-place-index.ts",
    "build:contact-channels": "tsx scripts/build-contact-channels.ts",
    "preflight": "node scripts/preflight.mjs",
    "placeholders": "node scripts/make-placeholders.mjs",
    "images:generate": "node scripts/generate-images.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-mono": "5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@schafe-vorm-fenster/brand-design": "2.10.0",
    "@vercel/functions": "3.11.2",
    "js-yaml": "5.5.0",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@leafcutter-strict/blueprint-complete": "0.2.4",
    "@leafcutter-strict/library-schemas": "0.4.1",
    "@playwright/test": "1.65.0",
    "@schafe-vorm-fenster/audiences": "^0.3.3",
    "@schafe-vorm-fenster/brand-identity": "^0.1.4",
    "@schafe-vorm-fenster/goals": "^0.3.3",
    "@schafe-vorm-fenster/media-echo": "^0.3.3",
    "@schafe-vorm-fenster/messaging": "^0.1.0",
    "@schafe-vorm-fenster/offerings": "^0.3.5",
    "@schafe-vorm-fenster/partners": "^0.2.7",
    "@schafe-vorm-fenster/people": "^0.3.6",
    "@schafe-vorm-fenster/posts": "^0.4.0",
    "@schafe-vorm-fenster/proof": "^0.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "ai": "7.0.170",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "18.0.10",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.6",
    "googleapis": "189.0.0",
    "husky": "9.1.7",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vercel": "65.15.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.21": "^1.1.22",
      "brace-expansion@>=5 <5.0.12": "^5.0.13",
      "js-yaml@>=4 <4.3.2": "^4.3.2",
      "minimatch@>=10 <10.2.3": "^10.2.6",
      "path-to-regexp@>=8 <8.4.0": "^8.4.2",
      "smol-toml@<1.8.1": "^1.9.1",
      "source-map-js@<1.2.2": "^1.2.2",
      "tar@>=7 <7.5.21": "^7.5.23",
      "undici@>=6 <6.29.1": "^6.29.1",
      "undici@>=7 <7.30.1": "^7.30.2",
      "zod@>=4 <4.6.6": "^4.6.7"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint-plugin-import>eslint": "10",
        "eslint-plugin-jsx-a11y>eslint": "10",
        "eslint-plugin-react>eslint": "10"
      }
    }
  }
}
