    "/api/{token}/classify": {
      "post": {
        "description": "Classify a json object based on the given tags, summary, description and/or occurrence. Token must be provided in the URL path.",
        "summary": "Classify a json object",
        "tags": [
          "classify"
        ],
        "parameters": [
          {
            "name": "token",
            "in": "path",
