    "/api/{token}/scopify": {
      "post": {
        "description": "Scopify a json object based on the given data. If 'scopes' field is provided, static dictionary matching is attempted first before falling back to Google Gemini AI. Token must be provided in the URL path.",
        "summary": "Scopify a json object",
        "tags": [
          "scopify"
        ],
        "parameters": [
          {
            "name": "token",
