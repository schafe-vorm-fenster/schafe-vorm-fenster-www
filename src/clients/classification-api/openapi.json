                      }
                    ]
                  },
                  "category": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "summary": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "occurrence": {
                    "default": "once",
                    "type": "string"
                  }
                },
                "additionalProperties": {
                  "nullable": true
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "200",
